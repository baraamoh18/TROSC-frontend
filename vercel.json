{
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://trosc.onrender.com/v1/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?sitemap"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
