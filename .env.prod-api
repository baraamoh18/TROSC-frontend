# Loaded only by `npm run dev:prod-api` (vite --mode prod-api).
# WARNING: the dev server will read and write the PRODUCTION database.
DEV_API_TARGET=https://trosc.onrender.com
# The API only accepts browser writes (sign-in, forms) from the live
# site's origin, so the proxy sends this instead of localhost.
DEV_API_ORIGIN=https://trosc.vercel.app
